---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import WhatsApp from '../components/WhatsApp.astro';

const servicios = [
  { icon: '🖥️', nombre: 'Landing Page', desc: 'Página de aterrizaje rápida y efectiva, diseñada para convertir visitantes en clientes desde el primer día.' },
  { icon: '🔧', nombre: 'Mantención mensual', desc: 'Actualizaciones de contenido, soporte técnico y monitoreo incluidos. Tu sitio siempre actualizado.' },
  { icon: '📈', nombre: 'SEO básico', desc: 'Configuración inicial para que tu negocio aparezca en Google. Metaetiquetas, velocidad y buenas prácticas.' },
  { icon: '⚡', nombre: 'Rendimiento', desc: 'Sitios ultrarrápidos construidos con tecnología moderna. Carga en menos de 2 segundos.' },
  { icon: '📱', nombre: 'Diseño responsive', desc: 'Se adapta perfectamente a celular, tablet y escritorio. Sin excepciones.' },
  { icon: '🔒', nombre: 'SSL + Hosting', desc: 'Certificado de seguridad y alojamiento incluido en todos los planes. Sin costos ocultos.' },
  { icon: '💬', nombre: 'Botón WhatsApp', desc: 'Integración del botón flotante de WhatsApp para que tus clientes te contacten con un clic. (Plan Pro)' },
  { icon: '📊', nombre: 'Google Analytics', desc: 'Configuración de métricas para que veas cuántas personas visitan tu sitio y desde dónde. (Plan Pro)' },
];
---
<BaseLayout
  title="Servicios — Limón Digital"
  description="Landing pages, mantención mensual, SEO, diseño responsive y más. Todo lo que tu negocio necesita en internet."
>
  <Navbar />
  <main>
    <section class="header-section">
      <div class="inner">
        <span class="label">Lo que hacemos</span>
        <h1>Servicios pensados<br/>para crecer</h1>
        <p>Cada entregable está diseñado para que tu negocio funcione en internet sin complicaciones técnicas de tu parte.</p>
      </div>
    </section>

    <section class="services-section">
      <div class="inner">
        <div class="grid">
          {servicios.map((s, i) => (
            <div class={`card reveal reveal-delay-${i % 4}`}>
              <div class="icon">{s.icon}</div>
              <div class="nombre">{s.nombre}</div>
              <p>{s.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="proceso-section">
      <div class="inner">
        <span class="label">Cómo trabajamos</span>
        <h2>Del primer contacto<br/>al sitio live</h2>
        <div class="steps">
          <div class="step reveal">
            <div class="step-num">01</div>
            <div class="step-content">
              <strong>Conversamos</strong>
              <p>Nos cuentas de tu negocio, objetivos y lo que necesitas. Sin formularios largos ni reuniones interminables.</p>
            </div>
          </div>
          <div class="step reveal reveal-delay-1">
            <div class="step-num">02</div>
            <div class="step-content">
              <strong>Diseñamos</strong>
              <p>Creamos el diseño adaptado a tu marca y rubro. Te mostramos una propuesta antes de comenzar a programar tu sitio.</p>
            </div>
          </div>
          <div class="step reveal reveal-delay-2">
            <div class="step-num">03</div>
            <div class="step-content">
              <strong>Desarrollamos</strong>
              <p>Construimos tu sitio con tecnología moderna, rápida y optimizada para SEO y dispositivos móviles.</p>
            </div>
          </div>
          <div class="step reveal reveal-delay-3">
            <div class="step-num">04</div>
            <div class="step-content">
              <strong>Lanzamos</strong>
              <p>Tu sitio queda live con dominio, SSL y hosting configurados. Lo mantendremos mes a mes por ti.</p>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>
  <Footer />
  <WhatsApp />
</BaseLayout>

<script>
  const observer = new IntersectionObserver((entries) => {
    entries.forEach(e => { if (e.isIntersecting) e.target.classList.add('visible'); });
  }, { threshold: 0.15 });
  document.querySelectorAll('.reveal').forEach(el => observer.observe(el));
</script>

<style>
  .header-section { width: 100%; border-bottom: 1px solid rgba(255,255,255,0.06); }
  .inner { max-width: 1400px; margin: 0 auto; padding: 80px 48px; }
  .label { font-size: 11px; font-weight: 500; letter-spacing: 1.5px; text-transform: uppercase; color: var(--limon); display: block; margin-bottom: 16px; }
  h1 { font-family: var(--font-display); font-size: 48px; font-weight: 800; letter-spacing: -1.5px; line-height: 1.05; margin-bottom: 16px; }
  .header-section p { font-size: 16px; color: rgba(255,255,255,0.5); font-weight: 300; max-width: 520px; line-height: 1.8; }

  .services-section .inner { padding-top: 60px; padding-bottom: 60px; }
  .grid { display: grid; grid-template-columns: repeat(4,1fr); gap: 1px; background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.06); border-radius: 16px; overflow: hidden; }
  .card { background: var(--dark); padding: 32px 24px; transition: background 0.2s; }
  .card:hover { background: #1f1f1f; }
  .icon { width: 44px; height: 44px; background: rgba(196,229,56,0.1); border-radius: 10px; display: flex; align-items: center; justify-content: center; font-size: 20px; margin-bottom: 18px; }
  .nombre { font-family: var(--font-display); font-size: 15px; font-weight: 700; margin-bottom: 8px; }
  .card p { font-size: 13px; color: rgba(255,255,255,0.4); line-height: 1.7; }

  .proceso-section { width: 100%; background: var(--dark2); border-top: 1px solid rgba(255,255,255,0.06); }
  h2 { font-family: var(--font-display); font-size: 38px; font-weight: 800; letter-spacing: -1.2px; line-height: 1.1; margin-bottom: 48px; }
  .steps { display: grid; grid-template-columns: repeat(4,1fr); gap: 32px; }
  .step { display: flex; flex-direction: column; gap: 12px; }
  .step-num { font-family: var(--font-display); font-size: 12px; font-weight: 800; color: var(--limon); letter-spacing: 1px; }
  .step-content strong { display: block; font-family: var(--font-display); font-size: 16px; font-weight: 700; margin-bottom: 8px; }
  .step-content p { font-size: 13px; color: rgba(255,255,255,0.45); line-height: 1.7; }

  @media (max-width: 1024px) { .grid { grid-template-columns: repeat(2,1fr); } .steps { grid-template-columns: repeat(2,1fr); } }
  @media (max-width: 768px) {
    h1 { font-size: 32px; } h2 { font-size: 28px; }
    .inner { padding: 60px 24px; }
    .grid { grid-template-columns: 1fr; }
    .steps { grid-template-columns: 1fr; }
  }
</style>
