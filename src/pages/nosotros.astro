---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import WhatsApp from '../components/WhatsApp.astro';

const valores = [
  { icon: '🤖', titulo: 'AI First', desc: 'Usamos inteligencia artificial en cada etapa del proceso para entregar más rápido y con mejor calidad.' },
  { icon: '🌐', titulo: 'Remote First', desc: 'Trabajamos 100% remoto desde Valparaíso. Podemos atender clientes en cualquier parte de Chile y el mundo.' },
  { icon: '⚡', titulo: 'Agilidad', desc: 'Procesos simples y directos. Sin reuniones innecesarias, sin burocracia. Del brief al sitio live en días.' },
  { icon: '🤝', titulo: 'Trato cercano', desc: 'Somos un equipo pequeño. Cada cliente habla directamente con quien hace el trabajo, no con un intermediario.' },
];
---
<BaseLayout
  title="Nosotros — Limón Digital"
  description="Somos Limón Digital, una empresa de Valparaíso especializada en landing pages para PYMEs. AI First, Remote First."
>
  <Navbar />
  <main>
    <section class="header-section">
      <div class="inner">
        <span class="label">Sobre nosotros</span>
        <h1>Un equipo pequeño<br/>con visión grande</h1>
        <p>Somos <strong>Limón Digital SpA</strong>, constituida en Valparaíso con una filosofía clara: ayudar a PYMEs y emprendedores a tener presencia digital de calidad, sin pagar precios de agencia.</p>
      </div>
    </section>

    <section class="filosofia-section">
      <div class="inner">
        <div class="filo-grid">
          <div class="filo-text reveal">
            <span class="label">Nuestra filosofía</span>
            <h2>AI First.<br/>Remote First.</h2>
            <p>Creemos que la tecnología debe democratizarse. Las grandes empresas tienen acceso a los mejores diseñadores y desarrolladores — nosotros llevamos esa calidad a los negocios que más lo necesitan.</p>
            <p>Trabajamos con inteligencia artificial como herramienta central, lo que nos permite ofrecer calidad premium a precios accesibles y con tiempos de entrega que ninguna agencia tradicional puede igualar.</p>
          </div>
          <div class="filo-stats reveal reveal-delay-2">
            <div class="stat">
              <div class="val">7d</div>
              <div class="desc">Tiempo promedio de entrega de una landing completa</div>
            </div>
            <div class="stat">
              <div class="val">AI</div>
              <div class="desc">Cada proyecto potenciado con inteligencia artificial</div>
            </div>
            <div class="stat">
              <div class="val">100%</div>
              <div class="desc">Proyectos entregados con soporte post-lanzamiento</div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="valores-section">
      <div class="inner">
        <span class="label">Nuestros valores</span>
        <h2>Cómo trabajamos</h2>
        <div class="grid">
          {valores.map((v, i) => (
            <div class={`card reveal reveal-delay-${i % 4}`}>
              <div class="icon">{v.icon}</div>
              <div class="titulo">{v.titulo}</div>
              <p>{v.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="cta-section">
      <div class="inner">
        <div class="cta-box reveal">
          <h2>¿Quieres trabajar con nosotros?</h2>
          <p>Cuéntanos de tu proyecto y te respondemos en menos de 24 horas.</p>
          <div class="cta-btns">
            <a href="/contacto" class="btn-primary">Cotizar proyecto →</a>
            <a href="/demos" class="btn-outline">Ver demos primero</a>
          </div>
        </div>
      </div>
    </section>
  </main>
  <Footer />
  <WhatsApp />
</BaseLayout>

<script>
  const observer = new IntersectionObserver((entries) => {
    entries.forEach(e => { if (e.isIntersecting) e.target.classList.add('visible'); });
  }, { threshold: 0.15 });
  document.querySelectorAll('.reveal').forEach(el => observer.observe(el));
</script>

<style>
  .header-section { width: 100%; border-bottom: 1px solid rgba(255,255,255,0.06); }
  .inner { max-width: 1400px; margin: 0 auto; padding: 80px 48px; }
  .label { font-size: 11px; font-weight: 500; letter-spacing: 1.5px; text-transform: uppercase; color: var(--limon); display: block; margin-bottom: 16px; }
  h1 { font-family: var(--font-display); font-size: 48px; font-weight: 800; letter-spacing: -1.5px; line-height: 1.05; margin-bottom: 16px; }
  .header-section p { font-size: 16px; color: rgba(255,255,255,0.5); font-weight: 300; max-width: 560px; line-height: 1.8; }
  .header-section strong { color: var(--white); font-weight: 400; }

  .filosofia-section { width: 100%; background: var(--dark2); border-top: 1px solid rgba(255,255,255,0.06); }
  .filo-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 80px; align-items: center; }
  h2 { font-family: var(--font-display); font-size: 38px; font-weight: 800; letter-spacing: -1.2px; line-height: 1.1; margin-bottom: 20px; }
  .filo-text p { font-size: 15px; color: rgba(255,255,255,0.5); font-weight: 300; line-height: 1.9; margin-bottom: 14px; }
  .filo-stats { display: flex; flex-direction: column; gap: 16px; }
  .stat { background: var(--dark); border: 1px solid rgba(255,255,255,0.07); border-radius: 12px; padding: 24px; display: flex; align-items: center; gap: 20px; }
  .val { font-family: var(--font-display); font-size: 34px; font-weight: 800; color: var(--limon); min-width: 80px; letter-spacing: -1px; }
  .desc { font-size: 13px; color: rgba(255,255,255,0.45); line-height: 1.5; }

  .valores-section { width: 100%; border-top: 1px solid rgba(255,255,255,0.06); }
  .grid { display: grid; grid-template-columns: repeat(4,1fr); gap: 1px; background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.06); border-radius: 16px; overflow: hidden; margin-top: 48px; }
  .card { background: var(--dark); padding: 32px 24px; transition: background 0.2s; }
  .card:hover { background: #1f1f1f; }
  .icon { font-size: 24px; margin-bottom: 16px; }
  .titulo { font-family: var(--font-display); font-size: 16px; font-weight: 700; margin-bottom: 10px; }
  .card p { font-size: 13px; color: rgba(255,255,255,0.4); line-height: 1.7; }

  .cta-section { width: 100%; border-top: 1px solid rgba(255,255,255,0.06); }
  .cta-box { background: var(--dark2); border: 1px solid rgba(196,229,56,0.15); border-radius: 16px; padding: 56px; text-align: center; }
  .cta-box h2 { font-size: 32px; margin-bottom: 12px; }
  .cta-box p { font-size: 15px; color: rgba(255,255,255,0.5); margin-bottom: 32px; }
  .cta-btns { display: flex; gap: 12px; justify-content: center; flex-wrap: wrap; }
  .btn-primary { background: var(--limon); color: var(--dark); padding: 12px 24px; border-radius: 6px; font-size: 14px; font-weight: 500; text-decoration: none; transition: opacity 0.2s; }
  .btn-primary:hover { opacity: 0.88; }
  .btn-outline { background: transparent; color: var(--white); border: 1px solid rgba(255,255,255,0.25); padding: 12px 24px; border-radius: 6px; font-size: 14px; text-decoration: none; transition: border-color 0.2s, color 0.2s; }
  .btn-outline:hover { border-color: var(--limon); color: var(--limon); }

  @media (max-width: 1024px) { .grid { grid-template-columns: repeat(2,1fr); } }
  @media (max-width: 768px) {
    h1 { font-size: 32px; } h2 { font-size: 28px; }
    .inner { padding: 60px 24px; }
    .filo-grid { grid-template-columns: 1fr; gap: 40px; }
    .grid { grid-template-columns: 1fr; }
    .cta-box { padding: 36px 24px; }
  }
</style>
