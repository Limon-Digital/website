---
export interface Props {
  title?: string;
  description?: string;
}
const {
  title = 'Limón Digital — Landing pages para PYMEs y emprendedores',
  description = 'Creamos landing pages rápidas, modernas y efectivas. Presencia digital profesional para tu negocio desde $149.990.'
} = Astro.props;

// Google Analytics — reemplaza con tu ID cuando estés listo (ej: G-XXXXXXXXXX)
const GA_ID = 'G-Z9LTYQCKYT';
---
<!DOCTYPE html>
<html lang="es">
 <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="https://limondigital.cl/favicon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_CL" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    {GA_ID && (
      <>
        <script async src={`https://www.googletagmanager.com/gtag/js?id=${GA_ID}`}></script>
        <script define:vars={{ GA_ID }}>
          window.dataLayer = window.dataLayer || [];
          function gtag(){dataLayer.push(arguments);}
          gtag('js', new Date());
          gtag('config', GA_ID);
        </script>
      </>
    )}
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  @import '../styles/global.css';
</style>
