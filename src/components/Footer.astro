---
const año = new Date().getFullYear();
---
<footer class="footer">
  <div class="footer-top">
    <div class="brand">
      <div class="logo"><span>LIMÓN</span> DIGITAL</div>
      <p>Presencia digital profesional<br/>para PYMEs y emprendedores.</p>
    </div>
    <div class="links-group">
      <div class="link-col">
        <div class="col-title">Empresa</div>
        <a href="/nosotros">Sobre nosotros</a>
        <a href="/servicios">Servicios</a>
        <a href="/precios">Precios</a>
      </div>
      <div class="link-col">
        <div class="col-title">Demos</div>
        <a href="/demos">Ver todos</a>
        <a href="/demos#basic">Landing Básica</a>
        <a href="/demos#pro">Landing Pro</a>
      </div>
      <div class="link-col">
        <div class="col-title">Contacto</div>
        <a href="/contacto">Cotizar proyecto</a>
        <a href="mailto:contacto@limondigital.cl">contacto@limondigital.cl</a>
        <a href="https://www.instagram.com/limondigital.cl/" target="_blank">Instagram</a>
        <a href="https://www.facebook.com/limondigital.cl/" target="_blank">Facebook</a>
      </div>
    </div>
  </div>
  <div class="footer-bottom">
    <p>© {año} Limón Digital SpA · Valparaíso, Chile</p>
    <div class="legal">
      <a href="#">Privacidad</a>
      <a href="#">Términos</a>
    </div>
  </div>
</footer>

<style>
  .footer { border-top: 1px solid rgba(255,255,255,0.06); background: var(--dark2); }
  .footer-top { max-width: 1400px; margin: 0 auto; padding: 60px 48px 40px; display: flex; justify-content: space-between; gap: 60px; }
  .logo { font-family: var(--font-display); font-weight: 400; font-size: 20px; letter-spacing: -0.5px; margin-bottom: 12px; }
  .logo span { color: var(--limon); font-weight: 800; }
  .brand p { font-size: 13px; color: rgba(255,255,255,0.35); line-height: 1.7; }
  .links-group { display: flex; gap: 60px; }
  .link-col { display: flex; flex-direction: column; gap: 10px; }
  .col-title { font-family: var(--font-display); font-size: 11px; font-weight: 700; letter-spacing: 1.2px; text-transform: uppercase; color: rgba(255,255,255,0.4); margin-bottom: 4px; }
  .link-col a { font-size: 13px; color: rgba(255,255,255,0.5); text-decoration: none; transition: color 0.2s; }
  .link-col a:hover { color: var(--limon); }
  .footer-bottom { max-width: 1400px; margin: 0 auto; padding: 20px 48px; border-top: 1px solid rgba(255,255,255,0.06); display: flex; justify-content: space-between; align-items: center; }
  .footer-bottom p { font-size: 12px; color: rgba(255,255,255,0.2); }
  .legal { display: flex; gap: 20px; }
  .legal a { font-size: 12px; color: rgba(255,255,255,0.2); text-decoration: none; }
  .legal a:hover { color: var(--limon); }

  @media (max-width: 768px) {
    .footer-top { flex-direction: column; padding: 40px 24px 24px; gap: 36px; }
    .links-group { flex-direction: column; gap: 28px; }
    .footer-bottom { flex-direction: column; gap: 12px; padding: 20px 24px; text-align: center; }
  }
</style>
